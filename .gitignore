# updated .gitignore

# ==========================================
# Python & Jupyter
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.ipynb_checkpoints/
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/

# ==========================================
# Rust Workspace
# ==========================================
target/
**/target/

# Libraries should not commit Cargo.lock.
# Uncomment if Grove later ships executable applications.
Cargo.lock

# ==========================================
# Frontend (Node / Next.js)
# ==========================================
node_modules/
.next/
out/
coverage/

# ==========================================
# Docker
# ==========================================
.docker/

# ==========================================
# Runtime Logs & Temporary Files
# ==========================================
*.tmp
*.bak
*.log
*.pid

logs/
results/

# ==========================================
# Data Pipeline Storage (Local MVP)
# ==========================================
data/raw/
data/interim/
data/processed/

# ==========================================
# Research Pipeline Artifacts
# ==========================================
Extractor/population.json
Extractor/history.csv
Extractor/*.tmp

RAM/**/*.emb
RAM/**/*.cache

Logs/**/*.tmp
Theory/**/*.tmp

experiments/**/results/
experiments/**/logs/

# ==========================================
# Generated Outputs
# ==========================================
outputs/
outputs/**/*.json
outputs/**/*.md

# ==========================================
# Engine Runtime State
# ==========================================
engine/engine-core/ledger/*.json
engine/engine-core/ledger/*.jsonl
engine/engine-core/ledger/*.tmp
engine/engine-core/ledger/*.lock

# ==========================================
# Environment & Secrets
# ==========================================
.env
.env.local
.env.*.local

# Keep templates
!.env.example
!.env.production

# ==========================================
# IDE / Editor
# ==========================================
.vscode/
.idea/
.cache/

# ==========================================
# Operating System
# ==========================================
.DS_Store
Thumbs.db
*.swp
*.swo